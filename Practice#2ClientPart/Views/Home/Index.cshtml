@model List<Practice_2ClientPart.Data.Category>

@{
    ViewData["Title"] = "Каталог категорий";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Ошибка.</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

<h1 class="mb-4">Каталог категорий</h1>
<a asp-action="NewCategory" class="btn btn-success">
    + Добавить категорию

</a>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Категории не найдены или сервер недоступен.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 60px;">ID</th>
                <th>Название</th>
                <th>Описание</th>
                <th style="width: 120px;">Товаров</th>
                <th style="width: 200px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td><strong>@category.Name</strong></td>
                    <td>@(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)</td>
                    <td>@(category.Products?.Count ?? 0)</td>
                    <td>
                        <a class="btn btn-sm btn-outline-warning"
                           asp-action="Edit"
                           asp-route-name="@category.Name">Изменить</a>
                        <form asp-action="Delete"
                            asp-route-name="@category.Name"
                            method="post"
                            class="d-inline"
                            onsubmit="return confirm('Удалить категорию «@category.Name»?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}