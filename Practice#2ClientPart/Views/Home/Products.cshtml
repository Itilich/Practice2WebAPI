@model List<Practice_2ClientPart.Data.Product>

@{
    ViewData["Title"] = "Каталог товаров";
    var searchName = ViewBag.SearchName as string;
    var searchCategory = ViewBag.SearchCategory as string;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Каталог товаров</h1>
    <a asp-action="NewProduct" class="btn btn-success">+ Добавить товар</a>
</div>

<form asp-action="Products" method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="name" value="@searchName" class="form-control"
               placeholder="Название товара (точное)" />
    </div>
    <div class="col-md-4">
        <input type="text" name="categoryName" value="@searchCategory" class="form-control"
               placeholder="Категория (точное)" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Найти</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(searchName) || !string.IsNullOrWhiteSpace(searchCategory))
    {
        <div class="col-auto">
            <a asp-action="Products" class="btn btn-outline-secondary">Сбросить</a>
        </div>
    }
</form>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Товары не найдены.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 60px;">ID</th>
                <th>Название</th>
                <th style="width: 200px;">Категория</th>
                <th>Описание</th>
                <th style="width: 120px;">Цена</th>
                <th style="width: 260px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td><strong>@product.Name</strong></td>
                    <td>
                        <a asp-action="Products"
                           asp-route-categoryName="@product.CategoryName"
                           class="badge bg-secondary text-decoration-none">
                            @product.CategoryName
                        </a>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(product.Description) ? "—" : product.Description)</td>
                    <td>@product.Price.ToString("N2") ₽</td>
                    <td>
                        <a class="btn btn-sm btn-outline-warning"
                           asp-action="EditProduct"
                           asp-route-name="@product.Name">Изменить</a>

                        <form asp-action="DeleteProduct"
                              asp-route-name="@product.Name"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Удалить товар «@product.Name»?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}